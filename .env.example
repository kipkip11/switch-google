# Google Cloud OAuth 2.0 Credentials
# Tạo tại: https://console.cloud.google.com/apis/credentials
# Loại ứng dụng: Desktop App (hoặc Web App với callback http://localhost:8910/oauth2callback)

GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Cổng nhận callback khi xác thực tài khoản qua trình duyệt (mặc định: 8910)
AUTH_CALLBACK_PORT=8910

# Cổng Local API server cấp token cho bên thứ 3 (mặc định: 1909)
PORT=1909
